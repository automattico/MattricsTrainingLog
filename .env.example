SFTP_HOST=example.com
SFTP_PORT=22
SFTP_USER=mwiela
MATTRICS_REMOTE_DIR=sites/mattrics
# SSH key auth only — SFTP_PASSWORD is not supported; deploy.sh refuses to run if it is set.
# Public key of the deploy key; the private half lives in the SSH agent (Bitwarden desktop app).
SFTP_KEY_PATH=/Users/you/.ssh/id_ed25519_hetzner.pub
# Optional: agent socket for shells that do not export SSH_AUTH_SOCK.
# SFTP_IDENTITY_AGENT=/Users/you/.bitwarden-ssh-agent.sock
# Pinned host keys (committed). Populate once: ssh-keyscan -p 22 $SFTP_HOST >> deploy/known_hosts
SFTP_KNOWN_HOSTS=deploy/known_hosts
